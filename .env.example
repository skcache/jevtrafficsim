# Jev citywide controller (Issue #13).
#
# SERVER-SIDE ONLY. These are read by app/api/jev/policy/route.ts and by
# `pnpm benchmark --jev live|gateway`; no browser, worker or bundle ever sees
# them. The browser path (createRelayJevClient) posts to our own route, which
# holds the credential, so no token is ever shipped to a client.
#
# Leave these unset and Jev simply has no policy: the controller runs with its
# neutral policy and the adapter records the failure. Nothing is fabricated, and
# there is no replay or cached fallback (that is Issue #14).

# --- backend choice -------------------------------------------------------
# JEV_MODEL set    -> TypeSafe AI's evaluation model on the Vercel AI Gateway.
# JEV_ENDPOINT set -> a service that speaks the Jev policy schema directly.
# The two are never mixed: JEV_MODEL selects the gateway and ignores JEV_ENDPOINT.
JEV_MODEL=

# Base URL of a schema-speaking Jev service, e.g. https://jev.example.com/policy
JEV_ENDPOINT=

# Optional override for the gateway URL (a self-hosted proxy, for instance).
JEV_GATEWAY_URL=

# --- credentials ----------------------------------------------------------
# Vercel AI Gateway API key (or the schema service's token). Never commit one.
JEV_TOKEN=

# Optional per-request timeout in ms. The code default (4000 against a schema
# service, 15000 against the gateway) is conservative; production runs 12000
# because the free evaluation tier's latency is variable and a tight timeout
# turns slow-but-good answers into fallback time.
JEV_TIMEOUT_MS=

# Optional id of a Vercel Firewall rate-limit rule for /api/jev/policy. When set
# and a matching rule exists, the platform enforces the limit across every
# instance of the deployment; the route also keeps a small per-instance budget
# that bounds a runaway caller on one instance. Creating the rule is a dashboard
# action: Firewall -> Custom Rules -> rate limit on /api/jev/policy, then copy its
# id here.
JEV_RATE_LIMIT_ID=

# Optional minimum confidence for one gateway answer, in [0, 1]. Answers below it
# never shape a policy; the field falls back to the schema's neutral default. The
# adapter's own default applies when this is unset.
JEV_MIN_CONFIDENCE=
