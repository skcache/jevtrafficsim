# Jev citywide controller (Issue #13).
#
# SERVER-SIDE ONLY. These are read by app/api/jev/policy/route.ts and by
# `pnpm benchmark --jev live`; no browser, worker or bundle ever sees them. The
# browser path (createRelayJevClient) posts to our own route, which holds the
# credential, so no token is ever shipped to a client.
#
# Leave these unset and Jev simply has no policy: the controller runs with its
# neutral policy and the adapter records the failure. Nothing is fabricated, and
# there is no replay or cached fallback (that is Issue #14).

# Base URL of the Jev policy service, e.g. https://jev.example.com/policy
JEV_ENDPOINT=

# Bearer token for the service. Never commit a real value.
JEV_TOKEN=

# Optional per-request timeout in ms (default 4000).
JEV_TIMEOUT_MS=
